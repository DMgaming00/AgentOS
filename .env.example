# Copy to .env and adjust. Never commit real secrets.

# --- Required for anything beyond local development ---------------------------
# AGENTOS_ENVIRONMENT=production refuses to start with dev defaults.
AGENTOS_ENVIRONMENT=development
AGENTOS_JWT_SECRET=dev-insecure-jwt-secret-change-me-0000
POSTGRES_PASSWORD=agentos

# --- Execution mode: paid providers are blocked in code unless ALL FOUR are set --
# An API key alone never enables them. See docs/ENABLE_REAL_CLAUDE.md before changing these.
AGENTOS_EXECUTION_MODE=offline
AGENTOS_ALLOW_PAID_PROVIDERS=false
AGENTOS_MAX_REAL_API_SPEND_USD=0
AGENTOS_ENABLE_NETWORK_MODEL_REQUESTS=false

# --- Model providers (optional; the mock provider needs no key) ---------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
AGENTOS_ANTHROPIC_MODEL=claude-opus-5-5
# No default OpenAI model is shipped: set a model ID you have verified.
# AGENTOS_OPENAI_MODEL=
# Planner used for AI-planned workflows: mock | anthropic | openai
AGENTOS_PLANNER_PROVIDER=mock
# Autopilot diagnosis/optimizer models (used only when the workspace policy selects that provider)
AGENTOS_AUTOPILOT_ANTHROPIC_MODEL=claude-haiku-5-5
# AGENTOS_AUTOPILOT_OPENAI_MODEL=
# Seed the demo agents against a real provider instead of the mock: mock | anthropic | openai
AGENTOS_DEMO_PROVIDER=mock

# --- Local (non-docker) development -------------------------------------------
AGENTOS_DATABASE_URL=postgresql+asyncpg://agentos:agentos@localhost:55432/agentos
AGENTOS_REDIS_URL=redis://localhost:56379/0
AGENTOS_ARTIFACT_DIR=./var/artifacts
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Engine tuning ------------------------------------------------------------
AGENTOS_LEASE_TTL_SECONDS=15
AGENTOS_HEARTBEAT_INTERVAL_SECONDS=3
AGENTOS_WORKER_CONCURRENCY=4

# --- Observability (optional) -------------------------------------------------
AGENTOS_OTEL_ENABLED=false
AGENTOS_OTEL_ENDPOINT=http://localhost:4318
