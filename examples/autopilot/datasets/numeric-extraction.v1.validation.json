{
  "name": "numeric-extraction",
  "version": 1,
  "split": "validation",
  "description": "Extract numeric facts with units and citations from fictional platform docs.",
  "cases": [
    {
      "case_id": "numx-002",
      "task": "From the workspace documents, extract for Helix Serve: p95 latency (ms); Price per 1M output tokens (USD). Return a JSON object with the keys p95_latency_ms, price_per_1m_output_tokens_usd and a 'citations' object mapping each key to the document section you used. Use null for any value the documents do not state.",
      "input": {
        "subject": "Helix Serve",
        "fields": [
          {
            "key": "p95_latency_ms",
            "label": "p95 latency",
            "unit": "ms",
            "subject": "Helix Serve"
          },
          {
            "key": "price_per_1m_output_tokens_usd",
            "label": "Price per 1M output tokens",
            "unit": "USD",
            "subject": "Helix Serve"
          }
        ],
        "documents": [
          "platform-helix.md"
        ]
      },
      "input_artifacts": [
        "platform-helix.md"
      ],
      "expected_output": {
        "p95_latency_ms": 300,
        "price_per_1m_output_tokens_usd": 0.95
      },
      "evaluation_methods": [
        "schema_validation",
        "numeric_tolerance",
        "source_citation_check",
        "tool_correctness",
        "task_completion"
      ],
      "evaluator_config": {
        "numeric_tolerance": {
          "fields": {
            "p95_latency_ms": {
              "abs": 0.5
            },
            "price_per_1m_output_tokens_usd": {
              "abs": 0.001
            }
          }
        },
        "tool_correctness": {
          "required_tools": [
            "document_search"
          ],
          "max_calls": 6,
          "max_identical_calls": 2
        }
      },
      "tags": [
        "numerical_extraction",
        "retrieval",
        "currency"
      ]
    },
