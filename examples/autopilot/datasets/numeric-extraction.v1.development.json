{
  "name": "numeric-extraction",
  "version": 1,
  "split": "development",
  "description": "Extract numeric facts with units and citations from fictional platform docs.",
  "cases": [
    {
      "case_id": "numx-001",
      "task": "From the workspace documents, extract for Nimbus Inference: p95 latency (ms); Price per 1M output tokens (USD). Return a JSON object with the keys p95_latency_ms, price_per_1m_output_tokens_usd and a 'citations' object mapping each key to the document section you used. Use null for any value the documents do not state.",
      "input": {
        "subject": "Nimbus Inference",
        "fields": [
          {
            "key": "p95_latency_ms",
            "label": "p95 latency",
            "unit": "ms",
            "subject": "Nimbus Inference"
          },
          {
            "key": "price_per_1m_output_tokens_usd",
            "label": "Price per 1M output tokens",
            "unit": "USD",
            "subject": "Nimbus Inference"
          }
        ],
        "documents": [
          "platform-nimbus.md"
        ]
      },
      "input_artifacts": [
        "platform-nimbus.md"
      ],
      "expected_output": {
        "p95_latency_ms": 420,
        "price_per_1m_output_tokens_usd": 1.2
      },
      "evaluation_methods": [
        "schema_validation",
        "numeric_tolerance",
        "source_citation_check",
        "tool_correctness",
        "task_completion"
      ],
      "evaluator_config": {
        "numeric_tolerance": {
          "fields": {
            "p95_latency_ms": {
              "abs": 0.5
            },
            "price_per_1m_output_tokens_usd": {
              "abs": 0.001
            }
          }
        },
        "tool_correctness": {
          "required_tools": [
            "document_search"
          ],
          "max_calls": 6,
          "max_identical_calls": 2
        }
      },
      "tags": [
        "numerical_extraction",
        "retrieval",
        "currency"
      ]
    },
